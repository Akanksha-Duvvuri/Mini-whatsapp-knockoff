<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your chat</title>
</head>
<body>
    <h1>Edit your Chat: <%= chat._id %></h1>
    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
        <textarea name="msg" rows="5" cols="50"><%=chat.msg%></textarea><br><br>
        <button>Edit</button>
    </form>
</body>
</html>