<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp knockoff</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>All Chats</h1>
    <% for(let chat of chats){ %>
    <div class="chat">
        <p>From: <%= chat.from %></p>
        <div class="msg">
            <p>Message: <%= chat.msg %></p>
            <form method="GET" action="/chats/<%= chat._id %>/edit">
                <button>Edit</button>
            </form>
             <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE">
                <button>delete Chat</button>
             </form>
        </div>
        <p>To: <%= chat.to %></p>
        <p><%= chat.created_at.toString().split(" ")[4] %></p>
        <p><%= chat.created_at.toString().split(" ").splice(0,4).join("-") %></p>


    </div>
<% } %>

<form method="GET" action="/chats/new">
    <button>New Chat</button>
</form>

</body>
</html>

